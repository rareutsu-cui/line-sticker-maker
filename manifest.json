{
  "manifest_version": 3,
  "name": "スタンプメーカー",
  "version": "2.0.0",
  "description": "画像の配置、背景の透過、文字入れとPNG・ZIP保存ができるスタンプ編集ツール。",
  "icons": {
    "128": "icon-192.png"
  },
  "action": {
    "default_title": "スタンプメーカーを開く",
    "default_icon": "icon-192.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
